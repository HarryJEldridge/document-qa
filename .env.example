# ── Claude ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Oura Ring ──────────────────────────────────────────────────────────────────
# Get from: https://cloud.ouraring.com/personal-access-tokens
OURA_API_KEY=

# ── Atlassian (Jira + Confluence share the same token) ─────────────────────────
# Email: your Atlassian account email
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

CONFLUENCE_BASE_URL=https://yourcompany.atlassian.net
# Leave blank to reuse JIRA_API_TOKEN
CONFLUENCE_API_TOKEN=

# ── HubSpot ────────────────────────────────────────────────────────────────────
# Private app token from: Settings > Integrations > Private Apps
HUBSPOT_API_KEY=

# ── Google Calendar ────────────────────────────────────────────────────────────
# OAuth2 — run: npx ts-node scripts/auth-google.ts to get these
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Microsoft Outlook ──────────────────────────────────────────────────────────
# Azure app registration with Calendars.Read scope
# OAuth2 — run: npx ts-node scripts/auth-microsoft.ts to get these
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REFRESH_TOKEN=
MICROSOFT_TENANT_ID=common

# ── Gmail (Phase 2) ────────────────────────────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ── Excel (Phase 2) ────────────────────────────────────────────────────────────
EXCEL_FILE_PATH=

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
